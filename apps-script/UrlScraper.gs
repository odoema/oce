// OCE Public URL Collector V1
// Public/authorized pages only. No login, CAPTCHA, paywall or access-control bypass.
// Marketing consent is always handled separately by OCE.
const OCE_SCRAPER={VERSION:'1.0.0',MAX_BYTES:750000,MAX_REDIRECTS:3};
function doPost(e){try{const b=JSON.parse((e&&e.postData&&e.postData.contents)||'{}');requireScraperToken_(b.token);if(b.action!=='scan')throw Error('Unsupported action');return json_({ok:true,result:scrapeUrl_(String(b.url||''))});}catch(err){return json_({ok:false,error:String(err.message||err)});}}
function scrapeUrl_(input){let url=normalizeUrl_(input),r=null;for(let hop=0;hop<=OCE_SCRAPER.MAX_REDIRECTS;hop++){validatePublicUrl_(url);r=UrlFetchApp.fetch(url,{method:'get',followRedirects:false,muteHttpExceptions:true,headers:{'User-Agent':'OCE-Public-Collector/1.0'}});const c=r.getResponseCode();if([301,302,303,307,308].indexOf(c)>=0){const h=r.getHeaders(),loc=h.Location||h.location;if(!loc)throw Error('Redirect without Location');url=new URL(String(loc),url).toString();continue;}break;}if(!r)throw Error('No response');const c=r.getResponseCode();if(c<200||c>=400)throw Error('Source returned HTTP '+c);let html=r.getContentText();if(html.length>OCE_SCRAPER.MAX_BYTES)html=html.slice(0,OCE_SCRAPER.MAX_BYTES);return extractPage_(url,html);}
function normalizeUrl_(x){let u=String(x||'').trim();if(!u)throw Error('URL is required');if(!/^https?:\/\//i.test(u))u='https://'+u;const p=new URL(u);if(p.protocol!=='http:'&&p.protocol!=='https:')throw Error('Only HTTP/HTTPS URLs are allowed');return p.toString();}
function validatePublicUrl_(u){const h=new URL(u).hostname.toLowerCase();if(!h||h==='localhost'||h.endsWith('.localhost')||h==='127.0.0.1'||h==='::1'||h==='0.0.0.0')throw Error('Local/internal host blocked');if(/^169\.254\./.test(h)||/^10\./.test(h)||/^192\.168\./.test(h)||/^172\.(1[6-9]|2\d|3[0-1])\./.test(h))throw Error('Private/internal host blocked');}
function extractPage_(url,html){const title=decode_(match_(html,/<title[^>]*>([\s\S]*?)<\/title>/i)||'');const description=decode_(match_(html,/<meta[^>]+(?:name|property)=["'](?:description|og:description)["'][^>]+content=["']([^"']*)["']/i)||'');const links=[],re=/<a[^>]+href=["']([^"']+)["'][^>]*>([\s\S]*?)<\/a>/ig;let m;while((m=re.exec(html))&&links.length<300){const label=stripHtml_(m[2]).replace(/\s+/g,' ').trim();if(label)links.push({label,url:resolve_(m[1],url)});}return{source_url:url,collected_at:new Date().toISOString(),title,description,links,jsonld:extractJsonLd_(html),tables:extractTables_(html).slice(0,500),text:stripHtml_(html).replace(/\s+/g,' ').trim().slice(0,12000),marketing_consent_required:true};}
function extractJsonLd_(h){const o=[],r=/<script[^>]+type=["']application\/ld\+json["'][^>]*>([\s\S]*?)<\/script>/ig;let m;while((m=r.exec(h))&&o.length<20){try{o.push(JSON.parse(m[1].trim()));}catch(e){}}return o;}
function extractTables_(h){const o=[],r=/<tr[^>]*>([\s\S]*?)<\/tr>/ig;let m;while((m=r.exec(h))&&o.length<500){const cells=[],td=/<t[dh][^>]*>([\s\S]*?)<\/t[dh]>/ig;let c;while((c=td.exec(m[1])))cells.push(stripHtml_(c[1]).replace(/\s+/g,' ').trim());if(cells.length)o.push(cells);}return o;}
function stripHtml_(s){return decode_(String(s).replace(/<script[\s\S]*?<\/script>/ig,' ').replace(/<style[\s\S]*?<\/style>/ig,' ').replace(/<[^>]+>/g,' ').replace(/&nbsp;/gi,' '));}
function decode_(s){return String(s).replace(/&amp;/g,'&').replace(/&quot;/g,'"').replace(/&#39;/g,"'").replace(/&lt;/g,'<').replace(/&gt;/g,'>');}
function match_(s,r){const m=s.match(r);return m&&m[1];}function resolve_(h,b){try{return new URL(h,b).toString();}catch(e){return h;}}
function requireScraperToken_(t){const x=PropertiesService.getScriptProperties().getProperty('OCE_SCRAPER_TOKEN');if(!x||!t||t!==x)throw Error('Unauthorized');}
function json_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);}
