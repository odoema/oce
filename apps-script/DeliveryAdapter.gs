const OCE_DELIVERY={VERSION:'1.2.0',DEFAULT_MODE:'DRY_RUN',MAX_BATCH_SIZE:250};
function deliveryMode_(){return String(PropertiesService.getScriptProperties().getProperty('OCE_DELIVERY_MODE')||OCE_DELIVERY.DEFAULT_MODE).toUpperCase()}
function deliveryConfig_(){const p=PropertiesService.getScriptProperties();return{mode:deliveryMode_(),endpoint:String(p.getProperty('OCE_DELIVERY_ENDPOINT')||''),token:String(p.getProperty('OCE_DELIVERY_TOKEN')||''),testRecipient:String(p.getProperty('OCE_TEST_RECIPIENT')||''),from:String(p.getProperty('OCE_FROM_EMAIL')||''),replyTo:String(p.getProperty('OCE_REPLY_TO')||'')}}
function testDeliveryConfiguration(){const c=deliveryConfig_();if(c.mode==='DRY_RUN')return{ok:true,mode:c.mode};if(!c.endpoint)throw Error('OCE_DELIVERY_ENDPOINT is missing from Script Properties.');if(!c.token)throw Error('OCE_DELIVERY_TOKEN is missing from Script Properties.');if(c.mode==='TEST'&&!isValidEmail_(c.testRecipient))throw Error('OCE_TEST_RECIPIENT must be a valid email address.');if(c.mode==='PRODUCTION'&&String(PropertiesService.getScriptProperties().getProperty('OCE_PRODUCTION_APPROVED')||'FALSE').toUpperCase()!=='TRUE')throw Error('Production delivery is not approved.');return{ok:true,mode:c.mode}}
function deliverQueueBatch_(campaign,rows){const c=deliveryConfig_();testDeliveryConfiguration();const batch=rows.slice(0,OCE_DELIVERY.MAX_BATCH_SIZE);if(!batch.length)return{accepted:0,skipped:0,results:[]};if(c.mode==='DRY_RUN')return{accepted:0,skipped:batch.length,results:batch.map(r=>({queueId:r[0],email:r[3],result:'DRY_RUN'}))};let recipients=batch.map(r=>({queue_id:r[0],contact_id:r[2],email:r[3],idempotency_key:r[0]}));if(c.mode==='TEST')recipients=recipients.slice(0,1).map(r=>Object.assign({},r,{original_email:r.email,email:c.testRecipient}));const payload={version:OCE_DELIVERY.VERSION,mode:c.mode,campaign:{id:campaign[0],name:campaign[1],subject:campaign[2],body_html:campaign[3],from:c.from,reply_to:c.replyTo},recipients:recipients};const res=UrlFetchApp.fetch(c.endpoint,{method:'post',contentType:'application/json',headers:{'X-OCE-Token':c.token,'X-OCE-Version':OCE_DELIVERY.VERSION},payload:JSON.stringify(payload),muteHttpExceptions:true});const code=res.getResponseCode(),text=res.getContentText();if(code<200||code>=300)throw Error('Delivery endpoint returned HTTP '+code+': '+text.slice(0,500));let data;try{data=JSON.parse(text)}catch(e){throw Error('Delivery endpoint returned non-JSON response.')}if(!Array.isArray(data.results))throw Error('Delivery endpoint response must contain results[].');return data}
function applyDeliveryResults_(campaignId,results){const ss=SpreadsheetApp.getActive(),q=ss.getSheetByName(OCE.SHEETS.QUEUE),l=ss.getSheetByName(OCE.SHEETS.LOG);if(!q||!l)return;const rows=q.getLastRow()>1?q.getRange(2,1,q.getLastRow()-1,12).getValues():[],byId=new Map(rows.map((r,i)=>[r[0],i+2]));results.forEach(x=>{const row=byId.get(x.queueId);if(!row)return;const status=String(x.result||'').toUpperCase(),next=status==='ACCEPTED'||status==='SENT'?'SENT':status==='SUPPRESSED'?'SUPPRESSED':'ERROR';q.getRange(row,6).setValue(next);q.getRange(row,8).setValue(next==='SENT'?new Date():'');q.getRange(row,9).setValue(x.message||'');q.getRange(row,10).setValue(x.provider_message_id||'');q.getRange(row,11).setValue(Number(q.getRange(row,11).getValue()||0)+1);q.getRange(row,12).setValue(new Date());l.appendRow([new Date(),campaignId,x.contactId||'',x.email||'',next,x.message||'',x.provider_message_id||''])})}
function processPendingDelivery(){const settings=readSettings_();if(settings.SEND_ENABLED!=='TRUE'||!withinWindow_(settings)||blockedToday_(settings))return;const ss=SpreadsheetApp.getActive(),ca=ss.getSheetByName(OCE.SHEETS.CAMPAIGNS),q=ss.getSheetByName(OCE.SHEETS.QUEUE);if(!ca||!q||ca.getLastRow()<2||q.getLastRow()<2)return;const campaigns=ca.getRange(2,1,ca.getLastRow()-1,11).getValues(),campaign=campaigns.find(r=>String(r[5]).toUpperCase()==='ACTIVE');if(!campaign)return;const rows=q.getRange(2,1,q.getLastRow()-1,12).getValues().filter(r=>r[1]===campaign[0]&&String(r[5]).toUpperCase()==='PENDING');const size=Math.min(Number(campaign[6])||Number(settings.BATCH_SIZE)||250,OCE_DELIVERY.MAX_BATCH_SIZE);if(!rows.length)return;const result=deliverQueueBatch_(campaign,rows.slice(0,size));if(result.results)applyDeliveryResults_(campaign[0],result.results);refreshDashboard()}
function configureDeliveryDryRun(){const p=PropertiesService.getScriptProperties();p.setProperty('OCE_DELIVERY_MODE','DRY_RUN');p.deleteProperty('OCE_PRODUCTION_APPROVED');SpreadsheetApp.getUi().alert('OCE delivery mode set to DRY_RUN. No email can be sent.')}
